# GEMINI_API_KEY: Required for Gemini AI API calls (injected in AI Studio runtime).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"

# Firebase Client SDK Configuration (for Vercel / external deployments)
# In AI Studio preview, firebase-applet-config.json is automatically used when these are unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
